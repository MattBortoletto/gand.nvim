  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment","punctuation.definition.comment"],
      "settings": { "foreground": "#92928C", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string","constant.character","markup.inline.raw"],
      "settings": { "foreground": "#A1BD88" }
    },
    {
      "name": "Escape",
      "scope": ["constant.character.escape","string.regexp"],
      "settings": { "foreground": "#C98759" }
    },
    {
      "name": "Number, boolean, constant",
      "scope": ["constant.numeric","constant.language","constant.other","variable.other.constant","variable.other.enummember"],
      "settings": { "foreground": "#B29ACB" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword","keyword.control","storage.type","storage.modifier"],
      "settings": { "foreground": "#E0B567" }
    },
    {
      "name": "Preprocessor",
      "scope": ["meta.preprocessor","keyword.control.directive","entity.name.function.preprocessor"],
      "settings": { "foreground": "#E0B567" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator","punctuation.separator","punctuation.terminator","punctuation.accessor"],
      "settings": { "foreground": "#92928C" }
    },
    {
      "name": "Brackets",
      "scope": ["punctuation.section","meta.brace","punctuation.definition.parameters"],
      "settings": { "foreground": "#DAD3C2" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function","support.function","meta.function-call"],
      "settings": { "foreground": "#C98759" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type","entity.name.class","entity.name.namespace","support.type","support.class","entity.other.inherited-class"],
      "settings": { "foreground": "#83C0B6" }
    },
    {
      "name": "Variable",
      "scope": ["variable","variable.parameter","meta.definition.variable"],
      "settings": { "foreground": "#DAD3C2" }
    },
    {
      "name": "Builtin variable",
      "scope": ["variable.language","support.variable"],
      "settings": { "foreground": "#E0B567" }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property","variable.other.object.property","support.type.property-name","meta.object-literal.key"],
      "settings": { "foreground": "#91ADD0" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#E0B567" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#C98759" }
    },
    {
      "name": "Special",
      "scope": ["punctuation.definition.template-expression","punctuation.section.embedded","storage.type.function.arrow"],
      "settings": { "foreground": "#C98759" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid","invalid.illegal"],
      "settings": { "foreground": "#D47E78" }
    },
    {
      "name": "Heading",
      "scope": ["markup.heading","entity.name.section"],
      "settings": { "foreground": "#E0B567", "fontStyle": "bold" }
    },
    {
      "name": "Bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Link",
      "scope": ["markup.underline.link","string.other.link"],
      "settings": { "foreground": "#83C0B6", "fontStyle": "underline" }
    },
    {
      "name": "Quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#92928C", "fontStyle": "italic" }
    },
    {
      "name": "List",
      "scope": ["punctuation.definition.list"],
      "settings": { "foreground": "#E0B567" }
    },
    {
      "name": "Inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#A1BD88" }
    },
    {
      "name": "Deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#D47E78" }
    },
    {
      "name": "Changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#E0B567" }
    }
  ],
  "semanticTokenColors": {
    "function": "#C98759",
    "method": "#C98759",
    "class": "#83C0B6",
    "struct": "#83C0B6",
    "interface": "#83C0B6",
    "enum": "#83C0B6",
    "type": "#83C0B6",
    "typeParameter": "#83C0B6",
    "namespace": "#83C0B6",
    "property": "#91ADD0",
    "enumMember": "#B29ACB",
    "variable": "#DAD3C2",
    "parameter": "#DAD3C2",
    "variable.readonly": "#B29ACB",
    "variable.defaultLibrary": "#E0B567",
    "keyword": "#E0B567"
  }
}
